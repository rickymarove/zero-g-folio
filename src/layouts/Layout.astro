---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Ricky Marove — Frontend Software Engineer",
    description = "Ricky Marove's personal portfolio — Software engineer specializing in front-end development, neo-brutalist digital playground, and creative web experiments.",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://rickyastro.pages.dev");
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL("/pic.jpeg", siteUrl).href;

const schemaData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Person",
            "@id": `${siteUrl.origin}#person`,
            name: "Ricky Marove",
            url: siteUrl.origin,
            jobTitle: "Software Engineer",
            address: {
                "@type": "PostalAddress",
                addressLocality: "Batam City",
                addressCountry: "ID",
            },
            sameAs: [
                "https://github.com/rickymarove",
                "https://www.instagram.com/rickymarove",
            ],
            knowsAbout: [
                "Frontend Development",
                "Astro",
                "React",
                "TypeScript",
                "Tailwind CSS",
                "Node.js",
                "Linux",
            ],
        },
        {
            "@type": "WebSite",
            "@id": `${siteUrl.origin}/#website`,
            url: `${siteUrl.origin}/`,
            name: "Ricky Marove",
            alternateName: ["ricky.space", "Ricky's Folio", "rickyastro"],
            description: description,
            publisher: {
                "@id": `${siteUrl.origin}#person`,
            },
        },
    ],
};
---

<!doctype html>
<html class="dark" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="Ricky Marove" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <!-- Structured Data (JSON-LD) for Google & AI Overviews -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schemaData)}
        ></script>
        <link href="https://fonts.googleapis.com" rel="preconnect" />
        <link
            crossorigin=""
            href="https://fonts.gstatic.com"
            rel="preconnect"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-background-light dark:bg-background-dark font-display overflow-x-hidden min-h-screen flex flex-col">
        <slot />
    </body>
</html>
